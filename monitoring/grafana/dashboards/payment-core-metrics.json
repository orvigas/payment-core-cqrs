{
  "title": "Payment Core Metrics",
  "uid": "payment-core-metrics",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Payment Initiation Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "rate(payment_initiated_total{application=\"payment-core\"}[5m])",
          "legendFormat": "initiated",
          "refId": "A"
        },
        {
          "expr": "rate(payment_captured_total{application=\"payment-core\"}[5m])",
          "legendFormat": "captured",
          "refId": "B"
        },
        {
          "expr": "rate(payment_refunded_total{application=\"payment-core\"}[5m])",
          "legendFormat": "refunded",
          "refId": "C"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active Payments",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "payment_active{application=\"payment-core\"}",
          "legendFormat": "active",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Payment Latency (P95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(payment_latency_seconds_bucket{application=\"payment-core\"}[5m]))",
          "legendFormat": "P95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, rate(payment_latency_seconds_bucket{application=\"payment-core\"}[5m]))",
          "legendFormat": "P50",
          "refId": "B"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "tags": ["payment-core", "prometheus"],
  "schemaVersion": 39
}
