{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".claude/CLAUDE.md",
    ".claude/rules/*.md",
    "workflow/DEVELOPMENT_WORKFLOW.md"
  ],
  "agent": {
    "backend-engineer": {
      "mode": "primary",
      "description": "Implements Payment Core features and fixes on a task branch. Default agent for coding sessions.",
      "prompt": "{file:../.claude/agents/backend-engineer.md}",
      "permission": {
        "edit": "allow",
        "bash": {
          "mvn *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch --show-current": "allow",
          "git branch *": "ask",
          "git add *": "allow",
          "git commit *": "allow",
          "git checkout -b task/*": "allow",
          "git checkout main*": "deny",
          "git switch main*": "deny",
          "git merge*": "deny",
          "git rebase*": "ask",
          "git push origin task/*": "allow",
          "git push -u origin task/*": "allow",
          "git push*main*": "deny",
          "git push*": "deny",
          "git commit-tree*": "deny",
          "git update-ref*": "deny",
          "git worktree*": "ask",
          "gh pr create*": "allow",
          "gh pr merge*": "deny",
          "gh pr *": "ask",
          "*": "ask"
        }
      }
    },
    "test-engineer": {
      "mode": "subagent",
      "description": "Writes and strengthens tests: coverage gaps, failure paths, edge cases, test infrastructure.",
      "prompt": "{file:../.claude/agents/test-engineer.md}"
    },
    "self-review": {
      "mode": "subagent",
      "description": "Pre-handoff review against governance rules before a task goes to Claude Code for the merge gate. Read-only.",
      "prompt": "{file:../.claude/agents/code-reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "mvn *": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git status*": "allow",
          "*": "ask"
        }
      }
    },
    "security-review": {
      "mode": "subagent",
      "description": "Security review against SECURITY_POLICY and OWASP for changes touching auth, payment endpoints, logging, configuration, or dependencies. Read-only.",
      "prompt": "{file:../.claude/agents/security-reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "mvn *": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git status*": "allow",
          "*": "ask"
        }
      }
    }
  }
}
